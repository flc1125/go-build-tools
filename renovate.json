{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration"
  ],
  "separateMajorMinor": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "constraints": {
    "go": "1.25.0"
  },
  "packageRules": [
    {
      "description": "Keep internal module versions managed by multimod",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/flc1125/go-build-tools",
        "github.com/flc1125/go-build-tools/**"
      ],
      "enabled": false
    },
    {
      "description": "Group Go subrepository updates",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "golang.org/x/**"
      ],
      "groupName": "golang.org/x"
    },
    {
      "description": "Group the CLI dependency stack",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/spf13/**"
      ],
      "groupName": "github.com/spf13"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    }
  ]
}
